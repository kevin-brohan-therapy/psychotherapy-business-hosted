			<item>
				<title>Welcome</title>
				<link>http://localhost:1313/home/welcome/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/home/welcome/</guid>
				<description>&lt;h4 id=&#34;welcome&#34;&gt;Welcome to Threshold&lt;/h4&gt;&#xD;&#xA;&lt;p&gt;&#xD;&#xA;Whether you&#39;re coming to therapy because of a specific difficulty, or with a broader sense of feeling stuck, overwhelmed or not fully yourself, therapy can provide a space to understand what is happening and begin moving towards meaningful change.&#xD;&#xA;&lt;/p&gt;&#xD;&#xA;&lt;p&gt;&#xD;&#xA;I&#39;m Kevin Brohan, a psychotherapy trainee working with individuals and couples online and face-to-face in Manchester and Stockport.&#xD;&#xA;&lt;/p&gt;&#xD;&#xA;&lt;h4 id=&#34;our-values&#34;&gt;My Ethos&lt;/h4&gt;&#xD;&#xA;&lt;p&gt;&#xD;&#xA;Therapy offers a confidential and collaborative relationship in which there is time to explore thoughts, feelings and experiences more deeply than is often possible elsewhere. Some people come with a clear goal, while others simply know that something doesn&#39;t feel right. Both are valid places to begin.&#xD;&#xA;&lt;/p&gt;</description>
			</item>
			<item>
				<title>Contact</title>
				<link>http://localhost:1313/home/contact/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/home/contact/</guid>
				<description>&lt;p style=&#34;text-align: center;&#34;&gt;To arrange an Introductory Call, please fill in the form below.&lt;/p&gt;&#xD;&#xA;&lt;!-- &#xD;&#xA;&lt;p&gt;Please state in your message if you have a preferred therapist. We will get in touch shortly via email.&lt;/p&gt;&#xD;&#xA;&lt;p style=&#34;text-align: center;&#34;&gt;&lt;em&gt;For trainees looking to join Threshold: please note we are not accepting new associates.&lt;/em&gt;&lt;/p&gt;&#xD;&#xA; --&gt;&#xD;&#xA;&lt;section id=&#34;contact&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;container&#34;&gt;&#xD;&#xA;    &lt;form&#xD;&#xA;      id=&#34;contact-form&#34;&#xD;&#xA;      method=&#34;POST&#34;&#xD;&#xA;      action=&#34;https://query-submission-api.vercel.app/api/contact&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;form-group&#34;&gt;&#xD;&#xA;        &lt;label for=&#34;name&#34;&gt;Name:&lt;/label&gt;&#xD;&#xA;        &lt;input type=&#34;text&#34; id=&#34;name&#34; name=&#34;name&#34; required&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;form-group&#34;&gt;&#xD;&#xA;        &lt;label for=&#34;email&#34;&gt;Email:&lt;/label&gt;&#xD;&#xA;        &lt;input type=&#34;email&#34; id=&#34;email&#34; name=&#34;email&#34; required&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;form-group&#34;&gt;&#xD;&#xA;        &lt;label for=&#34;phone&#34;&gt;Phone number:&lt;/label&gt;&#xD;&#xA;        &lt;input type=&#34;phone&#34; id=&#34;phone&#34; name=&#34;phone&#34; required&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;form-group&#34;&gt;&#xD;&#xA;        &lt;label for=&#34;message&#34;&gt;Message:&lt;/label&gt;&#xD;&#xA;        &lt;textarea id=&#34;message&#34; name=&#34;message&#34; rows=&#34;5&#34; required&gt;&lt;/textarea&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;!-- Honeypot field (should remain empty) --&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; name=&#34;website&#34; style=&#34;display:none&#34;&gt;&#xD;&#xA;      &lt;!-- Conversion quality info --&gt;&#xD;&#xA;      &lt;input type=&#34;hidden&#34; id=&#34;gclid_field&#34; name=&#34;gclid&#34; value=&#34;&#34;&gt;&#xD;&#xA;      &lt;script&gt;&#xD;&#xA;        // Make this callable from other scripts (e.g., your submit handler)&#xD;&#xA;        window.setGclid = function () {&#xD;&#xA;          const params = new URLSearchParams(window.location.search);&#xD;&#xA;          const gclid = params.get(&#39;gclid&#39;); // hash (#...) does not affect this&#xD;&#xA;          if (!gclid) {&#xD;&#xA;            console.log(&#39;No gclid in URL:&#39;, window.location.href);&#xD;&#xA;            return;&#xD;&#xA;          }&#xD;&#xA;          const field = document.getElementById(&#39;gclid_field&#39;);&#xD;&#xA;          if (field) {&#xD;&#xA;            field.value = gclid;&#xD;&#xA;            console.log(&#39;Set gclid_field to:&#39;, gclid);&#xD;&#xA;          } else {&#xD;&#xA;            console.log(&#39;gclid_field not found in DOM&#39;);&#xD;&#xA;          }&#xD;&#xA;        };&#xD;&#xA;        // Try immediately (covers most cases)&#xD;&#xA;        window.setGclid();&#xD;&#xA;        // And again once DOM is ready (covers edge cases)&#xD;&#xA;        document.addEventListener(&#39;DOMContentLoaded&#39;, window.setGclid);&#xD;&#xA;      &lt;/script&gt;&#xD;&#xA;      &lt;!-- Secret token --&gt;&#xD;&#xA;      &lt;input type=&#34;hidden&#34; name=&#34;secret_token&#34; value=&#34;f1b9a653-9b3e-4ae4-beb6-7a3a0b370cbc&#34;&gt;&#xD;&#xA;      &lt;!-- Origin tracking --&gt;&#xD;&#xA;      &lt;input type=&#34;hidden&#34; name=&#34;origin&#34; value=&#34;default&#34;&gt;&#xD;&#xA;      &lt;!-- CAPTCHA widget --&gt;&#xD;&#xA;      &lt;div class=&#34;g-recaptcha&#34; data-sitekey=&#34;6LcYA5krAAAAAO_CvK7iaeRvRRAtVw02ptdr4Ati&#34;&gt;&lt;/div&gt;&#xD;&#xA;      &lt;button type=&#34;submit&#34;&#xD;&#xA;        onclick=&#34;gtag(&#39;event&#39;, &#39;send_click&#39;, {&#xD;&#xA;          event_category: &#39;engagement&#39;,&#xD;&#xA;          event_label: &#39;Submit from Button&#39;,&#xD;&#xA;          value: 1&#xD;&#xA;        });&#34;&gt;Send&lt;/button&gt;&#xD;&#xA;    &lt;/form&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/section&gt;&#xD;&#xA;&lt;!-- Modal for sending spinner and eco message --&gt;&#xD;&#xA;&lt;div id=&#34;sending-modal&#34; style=&#34;display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(32,63,92,0.7); z-index:10000; align-items:center; justify-content:center;&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;modal-content&#34; style=&#34;background:#fff; border-radius:12px; padding:2rem 2.5rem; box-shadow:0 8px 32px rgba(32,63,92,0.2); text-align:center; max-width:350px; margin:auto;&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;spinner&#34; style=&#34;margin:0 auto 1.5rem auto;&#34;&gt;&lt;/div&gt;&#xD;&#xA;    &lt;h3 style=&#34;color:#203F5C; margin-bottom:1rem;&#34;&gt;Sending your message...&lt;/h3&gt;&#xD;&#xA;    &lt;p style=&#34;color:#555; font-size:1.1rem;&#34;&gt;Thank you for your patience...&lt;br&gt;My email server powers up only when needed, helping reduce energy use and protect the planet 🌍&lt;br&gt;This might take a few seconds to send.&lt;/p&gt;</description>
